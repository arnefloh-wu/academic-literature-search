# Copy to .env (same directory, git-ignored) or ~/.config/academic-search/.env
# Only the connectors whose keys are set will run; the rest fall back to web search.

# Polite-pool identifiers (optional, no registration)
OPENALEX_EMAIL=arne.floh@wu.ac.at
CROSSREF_EMAIL=arne.floh@wu.ac.at

# Free keys
S2_API_KEY=                 # semanticscholar.org/product/api (optional)
CORE_API_KEY=               # core.ac.uk/services/api
GOOGLE_API_KEY=             # Google Cloud Console, Books API (optional)
GITHUB_TOKEN=               # fine-grained token, public_repo read (optional, raises rate limit)
KAGGLE_USERNAME=
KAGGLE_KEY=

# WU-licensed / publisher APIs
SPRINGER_API_KEY=           # dev.springernature.com
ELSEVIER_API_KEY=           # dev.elsevier.com (Scopus); works on WU network/VPN
ELSEVIER_INSTTOKEN=         # institutional token for off-campus use (via library)
CLARIVATE_WOS_API_KEY=      # developer.clarivate.com, Web of Science Starter API
PRIMO_API_KEY=              # from WU Bibliothek (Ex Libris Developer Network)
PRIMO_VID=                  # e.g. 43ACC_WUW:CatalogPLUS (ask library)
PRIMO_API_HOST=https://api-eu.hosted.exlibrisgroup.com
PRIMO_SCOPE=MyInst_and_CI
PRIMO_TAB=Everything
PRIMO_DISCOVERY_BASE=       # e.g. https://wu.primo.exlibrisgroup.com
EDS_USER=
EDS_PASSWORD=
EDS_PROFILE=

# Zotero (scripts/zotero_sync.py). zotero.org > Settings > Security > Applications >
# "Create new private key" with "Allow library access" and "Allow write access".
# The user ID is shown on that page ("Your userID for use in API calls is ...").
ZOTERO_API_KEY=
ZOTERO_USER_ID=
ZOTERO_LIBRARY_TYPE=user    # user | group
ZOTERO_LIBRARY_ID=          # group ID when ZOTERO_LIBRARY_TYPE=group

# Dropbox upload (scripts/dropbox_upload.py). Create an app at dropbox.com/developers
# (scoped access, files.content.write + files.metadata.write), then either paste a
# short-lived access token or a refresh token with app key/secret for unattended runs.
DROPBOX_ACCESS_TOKEN=
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
